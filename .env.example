# ── HA Firebase (Home Automation project) ────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Client Config (for Google Home OAuth login page) ─────────────────
# NOTE: These are the SAME values as VITE_* versions above, but without the prefix
# They are needed for Vercel serverless functions to access Firebase config at runtime
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Firebase Admin SDK (Backend - Google Home API) ────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# ── Google OAuth (Google Home Integration) ────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Dexbot Firebase (separate project — read-only bot verification) ───────────
VITE_DEXBOT_API_KEY=
VITE_DEXBOT_AUTH_DOMAIN=
VITE_DEXBOT_DATABASE_URL=
VITE_DEXBOT_PROJECT_ID=
VITE_DEXBOT_STORAGE_BUCKET=
VITE_DEXBOT_MESSAGING_SENDER_ID=
VITE_DEXBOT_APP_ID=
