{
  "rules": {
    ".read":  false,
    ".write": false,

    "devices": {
      "$deviceId": {
        // Web dashboard reads device data (auth required).
        // ESP32 writes using its own Firebase anonymous/custom auth token.
        // Both paths require authentication — no public access.
        ".read": "auth != null",

        "outputs": {
          // Web app writes outputs (device control commands).
          // ESP32 reads outputs to execute them.
          ".read":  "auth != null",
          ".write": "auth != null",

          // Field-level validation — prevents garbage writes
          "oledMessage": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "light1":           { ".validate": "newData.isBoolean()" },
          "light2":           { ".validate": "newData.isBoolean()" },
          "light3":           { ".validate": "newData.isBoolean()" },
          "fan1":             { ".validate": "newData.isBoolean()" },
          "fan2":             { ".validate": "newData.isBoolean()" },
          "custom1":          { ".validate": "newData.isBoolean()" },
          "buzzer":           { ".validate": "newData.isBoolean()" },
          "light1Brightness": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "light2Brightness": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "light3Brightness": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "fan1Speed":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "fan2Speed":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
        },

        "health": {
          // ESP32 writes health metrics; web reads them.
          ".read":  "auth != null",
          ".write": "auth != null",
          "lastSeen":       { ".validate": "newData.isNumber() && newData.val() > 0" },
          "rssi":           { ".validate": "newData.isNumber()" },
          "heap":           { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "uptime":         { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "wifiUptime":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "restartCount":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "wifiStatus":     { ".validate": "newData.isString() && (newData.val() == 'connected' || newData.val() == 'disconnected')" },
          "firebaseStatus": { ".validate": "newData.isString() && (newData.val() == 'connected' || newData.val() == 'disconnected')" }
        },

        "analytics": {
          ".read":  "auth != null",
          ".write": "auth != null",
          "light1Runtime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "light2Runtime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "light3Runtime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "fan1Runtime":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "fan2Runtime":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "customRuntime": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 24" },
          "energyUsage":   { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },

        "onAt": {
          ".read":  "auth != null",
          ".write": "auth != null"
        },

        "analyticsDate": {
          ".read":  "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },

        "status": {
          ".read":  "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isString() && (newData.val() == 'online' || newData.val() == 'offline')"
        },

        "lastSeen": {
          ".read":  "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() > 0"
        },

        "metadata": {
          ".read":  "auth != null",
          ".write": "auth != null",
          "names": {
            ".read":  "auth != null",
            ".write": "auth != null",
            "light1":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "light2":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "light3":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "fan1":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "fan2":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "custom1": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" }
          },
          "outputs": {
            ".read":  "auth != null",
            ".write": "auth != null",
            "light1": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            },
            "light2": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            },
            "light3": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            },
            "fan1": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            },
            "fan2": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            },
            "custom1": {
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
              "icon": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" }
            }
          }
        }
      }
    },

    "linked_bots": {
      "$botId": {
        ".read":  "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['botId', 'linkedAt'])",
        "botId":    { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 32" },
        "linkedAt": { ".validate": "newData.isNumber() && newData.val() > 0" }
      }
    },

    // All other paths are denied
    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
